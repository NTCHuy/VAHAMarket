# ---- Supabase (Dashboard → Project Settings → API Keys) ----
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Chỉ dùng key dạng sb_publishable_... ở frontend. TUYỆT ĐỐI không đặt sb_secret_... vào file này.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# ---- Cloudinary (Settings → Upload → Upload presets → Signing Mode: Unsigned) ----
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# ---- Tên chủ tài khoản Escrow (hiển thị trên mã QR, IN HOA KHÔNG DẤU) ----
VITE_ESCROW_ACCOUNT_NAME=
